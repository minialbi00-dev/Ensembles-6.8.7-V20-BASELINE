+#!/usr/bin/env python3
+"""Source-level guards for external SF2 -> FluidSynth routing."""
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+MAIN = (ROOT / "src/main_qt.cpp").read_text(encoding="utf-8")
+
+
+def function_body(source: str, signature: str) -> str:
+    start = source.find(signature)
+    if start < 0:
+        raise AssertionError(f"function signature not found: {signature}")
+    opening = source.find("{", start)
+    depth = 0
+    for index in range(opening, len(source)):
+        if source[index] == "{":
+            depth += 1
+        elif source[index] == "}":
+            depth -= 1
+            if depth == 0:
+                return source[opening + 1:index]
+    raise AssertionError(f"unterminated function: {signature}")
+
+
+loader = function_body(
+    MAIN,
+    "bool loadSoundFont(const QString &path, bool persist, QString *errorOut = nullptr,",
+)
+chooser = function_body(MAIN, "void chooseSoundFont()")
+settings = function_body(MAIN, "void applyAudioOutputSettings()")
+
+checks = {
+    "SF2 loader defaults to FluidSynth instead of inferring renderer from route": (
+        "bool useLgGmNative = false" in MAIN
+        and 'currentData().toString() == QStringLiteral("lggm")' not in loader
+        and "candidate->initialize(useLgGmNative ? \"\" : encodedPath.constData()" in loader
+    ),
+    "LG-GM native renderer is an explicit opt-in only": (
+        "if (useLgGmNative)" in loader
+        and "candidate->loadLgGmNativeSoundFont(encodedPath.constData(), &error)" in loader
+        and "if (!useLgGmNative && !vst2PluginPath_.isEmpty())" in loader
+    ),
+    "manual external SF2 selection switches to FluidSynth route": (
+        'previousRoute == QStringLiteral("both")' in chooser
+        and 'QStringLiteral("fluid")' in chooser
+        and "loadSoundFont(path, true, &error, false)" in chooser
+        and 'settings.setValue(QStringLiteral("audio/outputRouting"), selectedRoute)' in chooser
+    ),
+    "dedicated Yamaha/Roland style renderer cannot be replaced underneath a running style": (
+        "isYamahaStyleExtension(activeStyleExtension_)" in chooser
+        and 'activeStyleExtension_ == QStringLiteral("stl")' in chooser
+    ),
+    "selecting LG-GM in the output route still explicitly loads native LS-GM": (
+        'route == QStringLiteral("lggm")' in MAIN
+        and "loadSoundFont(bank, false, &error, true)" in MAIN
+    ),
+    "audio-device changes preserve the explicitly selected LG-GM renderer": (
+        'currentData().toString() == QStringLiteral("lggm")' in settings
+        and "loadSoundFont(soundFontPath_, false, &error, useLgGmNative)" in settings
+    ),
+    "Yamaha style activation continues to use the native LS-GM sampler": (
+        "audioEngine_->loadLgGmNativeSoundFont(bankPath.constData(), &rendererError)" in MAIN
+    ),
+}
+
+failed = [name for name, passed in checks.items() if not passed]
+for name, passed in checks.items():
+    print(("PASS" if passed else "FAIL") + " " + name)
+if failed:
+    raise SystemExit(f"{len(failed)} external SF2 routing source checks failed")
+print(f"All {len(checks)} external SF2 routing source checks passed.")
